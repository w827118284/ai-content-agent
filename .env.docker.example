POSTGRES_DB=ai_content_agent
POSTGRES_USER=ai_content_agent
POSTGRES_PASSWORD=replace-with-local-docker-password
DATABASE_URL=postgresql://ai_content_agent:replace-with-local-docker-password@db:5432/ai_content_agent

CHECKPOINTER_BACKEND=postgres
LANGGRAPH_STRICT_MSGPACK=true

JWT_SECRET_KEY=replace-with-at-least-32-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:8080

USE_MOCK_LLM=true
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2

USE_MOCK_IMAGE=true
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL=doubao-seedream-5-0-260128
IMAGE_SIZE=2K
IMAGE_WATERMARK=true
IMAGE_MAX_CONCURRENCY=3

VITE_API_BASE_URL=/api/v1
