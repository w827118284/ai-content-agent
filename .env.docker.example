POSTGRES_DB=ai_content_agent
POSTGRES_USER=ai_content_agent
POSTGRES_PASSWORD=replace-with-local-docker-password
DATABASE_URL=postgresql://ai_content_agent:replace-with-local-docker-password@db:5432/ai_content_agent

CHECKPOINTER_BACKEND=postgres
LANGGRAPH_STRICT_MSGPACK=true

JWT_SECRET_KEY=replace-with-at-least-32-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:8080

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-content-agent
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

USE_MOCK_LLM=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

USE_MOCK_IMAGE=true
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.iotwq.top/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1008x1344
IMAGE_QUALITY=auto
IMAGE_OUTPUT_FORMAT=png
IMAGE_MODERATION=auto
IMAGE_N=1
IMAGE_MAX_CONCURRENCY=3
IMAGE_OUTPUT_DIR=/app/outputs/images
IMAGE_PUBLIC_PREFIX=/media/images
IMAGE_TIMEOUT_SECONDS=300

VITE_API_BASE_URL=/api/v1
