CONTENT_AGENT_APP_NAME=AI Content Operations Agent
CONTENT_AGENT_APP_VERSION=0.1.0
CONTENT_AGENT_API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-content-agent
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

CHECKPOINTER_BACKEND=memory
DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

USE_MOCK_LLM=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

USE_MOCK_IMAGE=true
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.iotwq.top/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1008x1344
IMAGE_QUALITY=auto
IMAGE_OUTPUT_FORMAT=png
IMAGE_MODERATION=auto
IMAGE_N=1
IMAGE_MAX_CONCURRENCY=3
IMAGE_OUTPUT_DIR=outputs/images
IMAGE_PUBLIC_PREFIX=/media/images
IMAGE_TIMEOUT_SECONDS=300
